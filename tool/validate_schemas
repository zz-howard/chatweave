#!/usr/bin/env bash
set -euo pipefail
trap 'printf "%s:%s: schema/conformance validation failed\n" "${BASH_SOURCE[0]}" "$LINENO" >&2' ERR
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
exec cargo run --locked --manifest-path "$root/rust/Cargo.toml" \
  -p chatweave-protocol --example validate_conformance -- "$root"
