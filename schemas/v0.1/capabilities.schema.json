{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zz-howard/chatweave/schemas/v0.1/capabilities.schema.json",
  "title": "ChatWeave Client Capabilities (0.1)",
  "description": "What a client can render. Sent with each request that may produce an assistant message (JSON body field or the compact ChatWeave-Capabilities header, see docs/protocol.md). The server uses it to pick protocol version and to prefer block types the client supports; clients must still fall back safely on anything unknown.",
  "type": "object",
  "required": ["protocolVersions", "blocks"],
  "additionalProperties": false,
  "properties": {
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
    },
    "blocks": {
      "description": "Block type -> highest supported schemaVersion.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "content-block.schema.json#/$defs/blockType" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 999 }
    },
    "features": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "stream.resume",
          "stream.snapshot",
          "stream.activity",
          "stream.steps",
          "action.choice",
          "action.confirmation",
          "action.form",
          "markdown.tables"
        ]
      }
    },
    "locale": {
      "description": "BCP 47 tag, used only for server-generated fallback text.",
      "type": "string",
      "maxLength": 35
    }
  }
}
